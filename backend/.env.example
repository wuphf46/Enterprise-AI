# AWS Configuration
AWS_ACCESS_KEY_ID = "your_aws_access_key_id"
AWS_SECRET_ACCESS_KEY = "your_aws_secret_access_key"
AWS_REGION = "us-east-1"
S3_BUCKET = "your_s3_bucket_name"

# Bedrock Model Configuration
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_CHAT_MODEL=amazon.nova-lite-v1:0
EMBED_DIM=1024

# Pinecone Vector Database Configuration
PINECONE_API_KEY = "your_pinecone_api_key"
PINECONE_INDEX_NAME = "enterprise-ai-index"
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_READY_TIMEOUT=180

# PostgreSQL Database Configuration
DATABASE_URL = your_postgresql_database_url

# Authentication
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace_with_a_random_32_plus_character_secret
JWT_ISSUER=enterprise-ai
JWT_AUDIENCE=enterprise-ai-web
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
AUTH_COOKIE_SECURE=false
AUTH_ALLOW_REGISTRATION=true

# Comma-separated browser origins. Keep empty when using the Vite dev proxy.
CORS_ORIGINS=